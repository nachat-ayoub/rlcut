{
  "name": "rlcut",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "desktop": "bash scripts/run.sh dev",
    "desktop:build": "bash scripts/run.sh build",
    "test": "node tests/frontend.test.mjs",
    "test:core": "bash scripts/test-core.sh",
    "lint": "eslint src",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "test:integration": "python3 tests/pipeline.py",
    "desktop:native": "tauri dev --features desktop",
    "desktop:build:native": "tauri build --features desktop",
    "doctor": "bash scripts/run.sh doctor",
    "check": "bash scripts/run.sh check",
    "test:environment": "bash tests/environment.test.sh",
    "desktop:build:windows": "powershell -NoProfile -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
